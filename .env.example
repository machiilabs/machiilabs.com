# Supabase Auth (Mach II Labs project — do not reuse kleimeyer credentials)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used for mailing-list writes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowlist. Only these emails can access /admin.
ADMIN_EMAILS=you@example.com
