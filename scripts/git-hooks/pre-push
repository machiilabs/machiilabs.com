#!/usr/bin/env bash
# main is production: Vercel deploys every push to machiilabs.com.
# Install with: bash scripts/install-git-hooks.sh
#
# Blocks a push to main unless MACHII_MAIN_PUSH=yes (the user explicitly approved
# this push to main). A history rewrite also needs MACHII_FORCE_MAIN=yes. Then runs
# scripts/check-production-release.sh from origin/main, which needs
# MACHII_SHIP="<product>-<version>" for any release this push ships.
set -euo pipefail

zero=0000000000000000000000000000000000000000
check=scripts/check-production-release.sh

block() {
  {
    printf '\n\033[1;31mpre-push: BLOCKED push to main (production).\033[0m\n'
    printf '%s\n' "$@"
    printf '\nSee .cursor/rules/production-main.mdc.\n\n'
  } >&2
  exit 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue

  [ "$local_sha" != "$zero" ] || block "Deleting main is never allowed from this machine."

  [ "${MACHII_MAIN_PUSH:-}" = "yes" ] || block \
    "Pushing to main publishes the live site." \
    "Only push after the user explicitly says to merge or push to main, then re-run with:" \
    "  MACHII_MAIN_PUSH=yes git push origin main"

  base="$remote_sha"
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git rev-parse --verify -q refs/remotes/origin/main || true)"
  elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    [ "${MACHII_FORCE_MAIN:-}" = "yes" ] || block \
      "This push rewrites main's history (not a fast-forward)." \
      "Only with explicit user approval: MACHII_FORCE_MAIN=yes"
  fi
  [ -n "$base" ] || block "Cannot find origin/main to compare against. Run: git fetch origin main"

  if git cat-file -e "refs/remotes/origin/main:$check" 2>/dev/null; then
    git show "refs/remotes/origin/main:$check" | bash -s -- "$base" "$local_sha" || exit 1
  else
    bash "$(git rev-parse --show-toplevel)/$check" "$base" "$local_sha" || exit 1
  fi
done

exit 0
